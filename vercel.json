{
  "redirects": [
    {
      "source": "/join/israel-open-2026",
      "destination": "/join/holon-israel-open-2026",
      "permanent": true
    },
    {
      "source": "/holon",
      "destination": "/join/holon-israel-open-2026",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/clubs/:id",
      "destination": "/api/club-og?id=:id"
    },
    {
      "source": "/tournaments/:id",
      "destination": "/api/tournament-og?id=:id"
    },
    {
