# Public Supabase project values (anon key, not service role)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Rally backend base URL (no trailing slash, no /rally/v1 suffix)
VITE_API_BASE_URL=http://localhost:8080

# Optional: AppsFlyer OneLink template for "open in the app" deep links.
# Defaults to the production template when unset.
# VITE_ONELINK_URL=https://rallypadel.onelink.me/pwv0

# Server-side base URL for the OG serverless function (api/club-og.ts).
# In Vercel, set API_BASE_URL to the production API origin.
API_BASE_URL=http://localhost:8080

# Server-side lead capture (api/lead.ts) — the Google Apps Script "web app"
# exec URL that appends form submissions to the Google Sheet, and an optional
# shared secret the script checks. Set both in the Vercel project (Production +
# Preview). See docs/leads-google-sheet.md for the one-time setup.
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/AKfy.../exec
# LEADS_WEBHOOK_TOKEN=some-long-random-string

# Optional: poll interval in ms for the public live tournament page
# (/live/:token). Defaults to 10000 when unset.
# VITE_POLL_INTERVAL=10000

# Meta Conversions API relay (api/meta-capi.js). Generated in Events Manager →
# pixel 1484965156419109 → Settings → Conversions API → "Generate access token".
# Without it the relay is inert (204) and only the browser pixel reports.
# META_CAPI_ACCESS_TOKEN=EAAB...
# Optional, temporary: the "Test events" code from Events Manager, to watch the
# server events arrive while verifying. Remove once confirmed.
# META_CAPI_TEST_CODE=TEST12345
